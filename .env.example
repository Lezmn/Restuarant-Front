# URL ของ API (NestJS) — ใช้ตอนต่อ backend จริง
VITE_API_URL="http://localhost:3000"

# เบอร์พร้อมเพย์ของร้าน สำหรับสร้าง QR รับเงิน
# ใส่เบอร์มือถือ หรือเลขประจำตัวผู้เสียภาษี 13 หลัก
# ถ้าไม่ตั้งค่า ระบบจะใช้เบอร์ตัวอย่างและขึ้นคำเตือนว่าเป็นโหมดเดโม
VITE_PROMPTPAY_ID="0812345678"

# ชื่อร้านที่แสดงบนหัวจอและใบเสร็จ
VITE_RESTAURANT_NAME="ร้านอาหารตามใจ ไม่ตามสั่ง"
