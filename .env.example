# URL ของ API (NestJS) — ใช้ตอนต่อ backend จริง
# build จริง (npm run build) ต้องตั้ง และต้องเป็น https:// (ยกเว้น localhost) ไม่งั้น build จะหยุด
VITE_API_URL="http://localhost:3000"

# เบอร์พร้อมเพย์ของร้าน สำหรับสร้าง QR รับเงิน
# ใส่เบอร์มือถือ หรือเลขประจำตัวผู้เสียภาษี 13 หลัก
# ถ้าไม่ตั้งค่า: ตอน dev ใช้เบอร์ตัวอย่าง · build จริงจะไม่สร้าง QR (กันเงินเข้าเบอร์คนอื่น)
VITE_PROMPTPAY_ID="0812345678"

# ชื่อร้านที่แสดงบนหัวจอและใบเสร็จ
VITE_RESTAURANT_NAME="ร้านอาหารตามใจ ไม่ตามสั่ง"

# โดเมนที่เติมท้ายชื่อผู้ใช้ตอน login (backend รับเฉพาะอีเมล)
# พิมพ์ "admin" → ส่ง "admin@restaurant.local" — ต้องตรงกับอีเมลของ user ในฐานข้อมูล
VITE_LOGIN_EMAIL_DOMAIN="restaurant.local"

# โชว์บัญชีตัวอย่าง + รหัสผ่าน seed บนหน้า login — dev โชว์เสมอ, build จริงโชว์เฉพาะเมื่อตั้ง true
# (เช่น เครื่องเดโมส่งอาจารย์) ห้ามเปิดกับร้านจริง
# VITE_SHOW_DEMO_LOGIN="true"
