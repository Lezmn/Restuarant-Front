# ตัวอย่าง nginx สำหรับเสิร์ฟ frontend ที่ build แล้ว (npm run build → dist/)
# CSP หลักฝังอยู่ใน index.html ตอน build แล้ว (vite.config.ts) — ตรงนี้ใส่ส่วนที่ meta ทำไม่ได้
#
# หมายเหตุ: nginx ไม่สืบทอด add_header จาก server ลง location ที่มี add_header ของตัวเอง
# จึงใส่ header ไว้ที่ server ที่เดียว แล้วใน location ใช้ expires แทน add_header

server {
    listen 80;
    server_name pos.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name pos.example.com;

    ssl_certificate     /etc/letsencrypt/live/pos.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pos.example.com/privkey.pem;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # บังคับ https ต่อจากนี้ (เปิดหลังแน่ใจว่า https ใช้ได้ทุกเครื่องแล้ว)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # ห้ามเว็บอื่นเอาหน้า POS ไปใส่ iframe หลอกให้กด (clickjacking)
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()" always;

    # ไฟล์ใน assets มี hash ในชื่อ แคชได้ยาว
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # SPA: ทุก path (/login, /t/<token>, /employee/...) ให้ index.html — และห้ามแคช ให้ได้เวอร์ชันใหม่ทันทีหลัง deploy
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
